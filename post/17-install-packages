intall_packages() {
    tik_progress_step "Installing required packages" 10
    tik_target_mount "" "required"
    prun /usr/bin/chroot "${TIK_ROOT_MNT}" transactional-update pkg install patterns-yuga-nonredistributable 1>&2
}

intall_packages
tik_progress_step "All packages installed" 100
